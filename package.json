{
  "name": "tempo",
  "version": "0.1.0",
  "description": "Non-Visual Video Editing Environment",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "cross-env BUILD_TYPE=dev npm run clean && cross-env BUILD_TYPE=dev tsc",
    "build:release": "cross-env BUILD_TYPE=release npm run build",
    "postbuild": "node scripts/update-version.js",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "make:icon": "node scripts/make-icon.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "build:exe": "npm run build:renderer && npm run build:electron && electron-builder --win",
    "make": "npm run make:icon && npm run build:exe"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^29.1.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
